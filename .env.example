# ==============================================================================
# CloudShip Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust values for your local environment.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Database Configuration
DB_NAME=cloudship_dev
DB_USERNAME=cloudship
DB_PASSWORD=cloudship_dev_password
DB_HOST=localhost
DB_PORT=5433
DB_SSL_MODE=disable
DB_POOL_SIZE=5

# Backend Server Configuration
SERVER_PORT=8088
SPRING_PROFILES_ACTIVE=dev

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_CLOUDSHIP=DEBUG

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8088,http://127.0.0.1:8088

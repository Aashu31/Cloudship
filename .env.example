# ==============================================================================
# CloudShip — Environment Variables Template (Azure-First)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' for local development:
#      cp .env.example .env
# 2. Update the values with your local/Azure settings.
# 3. WARNING: NEVER commit your real '.env' file or any secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Runtime Configuration
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
LOG_LEVEL_CLOUDSHIP=DEBUG
LOG_LEVEL_ROOT=INFO

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudship_dev
DB_USERNAME=cloudship
DB_PASSWORD=cloudship_dev_password
DB_POOL_SIZE=5
DB_SSL_MODE=disable

# ------------------------------------------------------------------------------
# Jenkins CI Automation (Introduced in Phase 3)
# ------------------------------------------------------------------------------
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_API_TOKEN=change_me_to_your_jenkins_api_token
JENKINS_JOB_NAME=cloudship-pipeline

# ------------------------------------------------------------------------------
# Microsoft Azure Cloud & ACR Configuration (Primary Cloud — Phase 4 & 5)
# ------------------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=change_me_to_azure_service_principal_secret
AZURE_RESOURCE_GROUP=rg-cloudship-dev
AZURE_LOCATION=eastus
AZURE_ACR_NAME=cloudshipcr
AZURE_ACR_LOGIN_SERVER=cloudshipcr.azurecr.io

# ------------------------------------------------------------------------------
# Kubernetes Orchestration (Introduced in Phase 6)
# ------------------------------------------------------------------------------
K8S_NAMESPACE=cloudship
K8S_DEPLOYMENT_NAME=cloudship-app
K8S_SERVICE_NAME=cloudship-service
K8S_REPLICAS=2

# ------------------------------------------------------------------------------
# Reliability & Automated Recovery Settings (Introduced in Phase 10-12)
# ------------------------------------------------------------------------------
ROLLBACK_TIMEOUT_SECONDS=180
HEALTH_CHECK_INTERVAL_SECONDS=10
HEALTH_FAILURE_THRESHOLD=3
AUTO_RECOVERY_ENABLED=true

# ------------------------------------------------------------------------------
# Future Multi-Cloud AWS Settings [FUTURE SCOPE — Phase 13 Only]
# (Do NOT configure or use in Phase 0 through 12)
# ------------------------------------------------------------------------------
# AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=000000000000
# AWS_ECR_REGISTRY_URI=000000000000.dkr.ecr.us-east-1.amazonaws.com
